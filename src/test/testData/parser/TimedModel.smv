@TIME_DOMAIN continuous
MODULE main
VAR
    c : clock;
    s : {idle, busy};
IVAR
    tick : clock;
FROZENVAR
    d : real;
INIT c = 0 & s = idle;
INVAR s = busy -> c <= 5;
URGENT s = idle & c = 0;
URGENT s = busy
TRANS next(s) != s -> next(c) = 0;
LTLSPEC G X~ (c > 0);
LTLSPEC G (Y~ s = busy -> s = busy);
LTLSPEC G (time_until(s = idle) <= 5);
LTLSPEC G (time_since(s = busy) > d);
LTLSPEC G ((time @F~ (s = idle)) >= 2);
INVARSPEC time >= 0;
